<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             x:Class="Maps.MainPage"
             Title="Maps">
    <Grid Padding="16" RowDefinitions="Auto,Auto,*">
        <Label FontAttributes="Bold"
               FontSize="24"
               Text="Campus map" />

        <Label Grid.Row="1"
               Margin="0,8,0,12"
               Text="A minimal Maps example with one fixed pin and one recenter action." />

        <VerticalStackLayout Grid.Row="2" Spacing="12">
            <Button Clicked="OnCenterOnCampusClicked"
                    Text="Center on HSHL" />

            <maps:Map x:Name="CampusMap"
                      HeightRequest="420"
                      MapType="Street" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>